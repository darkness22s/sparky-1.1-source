{
  "name": "sparky-launch-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "npm run build && node --test admin-release.test.mjs site-quality.test.mjs",
    "demo:build": "pnpm --config.verify-deps-before-run=false --dir ../sparky-desktop/source --filter @t3tools/web build:demo",
    "demo:sync": "npm run demo:build && node scripts/sync-demo.mjs",
    "deploy": "npm run build && npm run deploy:apex && npm run deploy:www",
    "deploy:apex": "npx --yes wrangler@4.114.0 pages deploy dist --project-name=sparky-web --branch=main",
    "deploy:www": "npx --yes wrangler@4.114.0 pages deploy dist --project-name=sparky-website --branch=main"
  },
  "devDependencies": {
    "vite": "^7.0.3"
  }
}
