# Keep this file free of real credentials. Set these in the backend host's secret store.
DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<database>?sslmode=require
MCP_SITE_URL=https://<backend-public-host>
MCP_TOKEN_ENCRYPTION_KEY=<32-byte-base64url-key>
MCP_ADMIN_SUBJECT=<clerk-subject>
CLERK_ISSUER=https://<your-clerk-issuer>
# Optional; use the audience configured in the Clerk JWT template.
CLERK_AUDIENCE=convex
# Comma-separated browser origins. Use * only for a controlled development deployment.
MCP_ALLOWED_ORIGINS=https://app.example.com
# Optional for providers that do not support dynamic client registration.
GITHUB_MCP_CLIENT_ID=
GITHUB_MCP_CLIENT_SECRET=
GOOGLE_MCP_CLIENT_ID=
GOOGLE_MCP_CLIENT_SECRET=
# Providers that expose OAuth metadata can use DCR; leave these empty unless
# the provider explicitly gives Sparky a fixed client registration.
VERCEL_MCP_CLIENT_ID=
VERCEL_MCP_CLIENT_SECRET=
SUPABASE_MCP_CLIENT_ID=
SUPABASE_MCP_CLIENT_SECRET=
LINEAR_MCP_CLIENT_ID=
LINEAR_MCP_CLIENT_SECRET=
NOTION_MCP_CLIENT_ID=
NOTION_MCP_CLIENT_SECRET=
FIGMA_MCP_CLIENT_ID=
FIGMA_MCP_CLIENT_SECRET=
PORT=8787
